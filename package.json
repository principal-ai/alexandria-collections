{
  "name": "@principal-ai/alexandria-collections",
  "version": "1.5.0",
  "author": "Principal AI Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/principal-ai/alexandria-collections.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.d.ts"
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.8.0"
  },
  "peerDependencies": {
    "@principal-ai/codebase-composition": "^0.2.0",
    "@principal-ai/repository-abstraction": ">=0.1.0"
  },
  "devDependencies": {
    "@principal-ai/codebase-composition": "^0.2.43",
    "@types/bun": "^1.1.20",
    "@types/node": "^22.15.26",
    "husky": "^9.1.7",
    "typescript": "^5.6.3"
  },
  "description": "Collection management for Principal AI Alexandria ecosystem",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "principal-ai",
    "alexandria",
    "collections",
    "repositories"
  ],
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "build": "bun run clean && bun run build:bundle && bun run build:types",
    "build:clean": "rm -rf dist",
    "build:bundle": "bun build ./src/index.ts --outfile ./dist/index.mjs --format esm --minify --sourcemap=inline && bun build ./src/index.ts --outfile ./dist/index.cjs --format cjs --minify --sourcemap=inline",
    "build:types": "bun run tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "type": "module"
}
