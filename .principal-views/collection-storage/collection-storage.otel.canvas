{
  "nodes": [
    {
      "id": "collection-create-started",
      "type": "text",
      "text": "# Collection Create Started\n\nEmitted when collection creation begins\n\n**Attributes:**\n- `input.name` (required): Collection name\n- `input.description`: Collection description\n- `storage.backend` (required): Storage backend type (github, localStorage, node, inmemory)",
      "x": -38,
      "y": -273,
      "width": 250,
      "height": 150,
      "color": "#3b82f6",
      "pv": {
        "event": {
          "name": "collection.create.started",
          "attributes": {
            "input.name": {
              "type": "string",
              "required": true
            },
            "input.description": {
              "type": "string",
              "required": false
            },
            "storage.backend": {
              "type": "string",
              "required": true
            }
          }
        },
        "status": "draft",
        "sources": [
          "src/CollectionStorageAdapter.ts"
        ],
        "otel": {
          "kind": "event",
          "category": "lifecycle"
        }
      }
    },
