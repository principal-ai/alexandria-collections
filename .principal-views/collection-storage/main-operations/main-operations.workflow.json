{
  "version": "1.0.0",
  "canvas": ".principal-views/collection-storage/collection-storage.otel.canvas",
  "name": "Main Operations",
  "description": "Collection and repository membership management operations",
  "mode": "span-tree",
  "spanPattern": "collection.**",
  "scenarios": [
    {
      "id": "collection-create-success",
      "priority": 1,
      "description": "Successful collection creation workflow",
      "template": {
        "summary": "Created collection \"{{output.name}}\" (ID: {{output.collectionId}})",
        "events": {
          "collection.create.started": "Starting collection creation for \"{{input.name}}\" using {{storage.backend}} storage",
          "collection.create.complete": "✓ Collection \"{{output.name}}\" created successfully ({{duration.ms}}ms)"
        }
      }
    },
    {
      "id": "collection-create-error",
      "priority": 2,
      "description": "Collection creation failure workflow",
      "template": {
        "summary": "Failed to create collection: {{error.message}}",
        "events": {
          "collection.create.started": "Starting collection creation for \"{{input.name}}\"",
          "collection.create.error": "✗ Creation failed: {{error.message}} (type: {{error.type}}, stage: {{error.stage}})"
        }
      }
    },
    {
      "id": "repository-add-success",
      "priority": 3,
      "description": "Successful repository addition workflow",
      "template": {
        "summary": "Added repository {{output.repositoryId}} to collection {{output.collectionId}}",
        "events": {
          "repository.add.started": "Adding repository {{input.repositoryId}} to collection {{input.collectionId}}",
          "repository.add.complete": "✓ Repository added successfully{{#output.alreadyExisted}} (already existed){{/output.alreadyExisted}} ({{duration.ms}}ms)"
        }
      }
    },
    {
      "id": "repository-add-error",
      "priority": 4,
      "description": "Repository addition failure workflow",
      "template": {
        "summary": "Failed to add repository: {{error.message}}",
        "events": {
          "repository.add.started": "Adding repository {{input.repositoryId}} to collection",
          "repository.add.error": "✗ Failed: {{error.message}} (type: {{error.type}}){{#error.collectionNotFound}} - collection not found{{/error.collectionNotFound}}"
        }
      }
    },
    {
      "id": "import-success",
      "priority": 5,
      "description": "Successful import workflow",
      "template": {
        "summary": "Imported {{result.collectionsImported}} collections and {{result.membershipsImported}} memberships (strategy: {{input.strategy}})",
        "events": {
          "import.started": "Starting import of {{input.collectionsCount}} collections and {{input.membershipsCount}} memberships using \"{{input.strategy}}\" strategy",
          "import.complete": "✓ Import complete: {{result.collectionsImported}} collections, {{result.membershipsImported}} memberships{{#result.collectionsUpdated}}, {{result.collectionsUpdated}} updated{{/result.collectionsUpdated}} ({{duration.ms}}ms)"
        }
      }
    },
    {
      "id": "import-error",
      "priority": 6,
      "description": "Import failure workflow",
      "template": {
        "summary": "Import failed: {{error.message}}",
        "events": {
          "import.started": "Starting import of {{input.collectionsCount}} collections using \"{{input.strategy}}\" strategy",
          "import.error": "✗ Import failed at {{error.stage}} stage: {{error.message}} (type: {{error.type}})"
        }
      }
    },
    {
      "id": "export-success",
      "priority": 7,
      "description": "Successful export workflow",
      "template": {
        "summary": "Exported {{output.collectionsCount}} collections and {{output.membershipsCount}} memberships",
        "events": {
          "export.started": "Starting export operation",
          "export.complete": "✓ Exported {{output.collectionsCount}} collections and {{output.membershipsCount}} memberships ({{duration.ms}}ms)"
        }
      }
    },
    {
      "id": "export-error",
      "priority": 8,
      "description": "Export failure workflow",
      "template": {
        "summary": "Export failed: {{error.message}}",
        "events": {
          "export.started": "Starting export operation",
          "export.error": "✗ Export failed: {{error.message}} (type: {{error.type}})"
        }
      }
    }
  ]
}
